    "/events": {
      "get": {
        "summary": "Get current and upcoming events",
        "tags": [
          "Events"
        ],
        "description": "Returns all events that are currently active or upcoming (not past events)",
        "responses": {
          "200": {
            "description": "List of current and upcoming events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "_id": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "startDate": {
                        "type": "string",
                        "format": "date"
                      },
                      "endDate": {
                        "type": "string",
                        "format": "date"
                      },
                      "startTime": {
                        "type": "string",
                        "example": "09:00"
                      },
                      "endTime": {
                        "type": "string",
                        "example": "17:00"
                      },
                      "location": {
                        "type": "string"
                      },
                      "image": {
                        "type": "string"
                      },
                      "active": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "summary": "Create a new event",
        "tags": [
          "Events"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Create a new event with image upload. Admin access required.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "description",
                  "startDate",
                  "endDate",
                  "startTime",
                  "endTime",
                  "location",
                  "image"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 100,
                    "description": "Event title"
                  },
                  "description": {
                    "type": "string",
                    "description": "Event description"
                  },
                  "startDate": {
                    "type": "string",
                    "format": "date",
                    "description": "Event start date (YYYY-MM-DD)"
                  },
                  "endDate": {
                    "type": "string",
                    "format": "date",
                    "description": "Event end date (YYYY-MM-DD)"
                  },
                  "startTime": {
                    "type": "string",
                    "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$",
                    "example": "09:00",
                    "description": "Event start time (HH:MM, 24-hour format)"
                  },
                  "endTime": {
                    "type": "string",
                    "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$",
                    "example": "17:00",
                    "description": "Event end time (HH:MM, 24-hour format)"
                  },
                  "location": {
                    "type": "string",
                    "description": "Event location"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Event image file"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Event created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or end date/time before start date/time"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Admin access required"
          }
        }
      }
    },
    "/events/all": {
      "get": {
        "summary": "Get all events (including past events)",
        "tags": [
          "Events"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
