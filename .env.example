# ─────────────────────────────────────────────────────────────────────────────
# Ubuntu Footprints — backend environment.
# Copy to .env and fill in. NEVER commit the real .env (it's gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# Core
NODE_ENV=production
PORT=5000

# MongoDB connection string (Dokploy/Swarm internal hostname in prod).
MONGO_URI=mongodb://user:pass@host:27017/dbname?authSource=admin

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=15m

# CORS / cookies — origins allowed to call the API and the cookie scope.
FRONTEND_BASE_URL=https://ubuntufootprints.com
ADMIN_BASE_URL=https://admin.ubuntufootprints.com
COOKIE_DOMAIN=.ubuntufootprints.com

# On-demand revalidation shared secret. MUST match the frontend's REVALIDATE_TOKEN.
REVALIDATE_TOKEN=

# ── Redis (rate-limit counters + OTP/session store) ──────────────────────────
# Either set REDIS_DATABASE_URL, or the discrete REDIS_HOST/PORT/PASSWORD below.
REDIS_DATABASE_URL=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Cloudinary (image uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Third-party APIs ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
IPAPI_ACCESS_KEY=
OPENWEATHERMAP_API_KEY=

# ── Indicative international airfare ─────────────────────────────────
# ALL OPTIONAL. With none of this set, /api/flights still works — it serves the
# hand-maintained fare guide in config/flightOrigins.js. A provider only upgrades
# those numbers from "checked quarterly by hand" to "sampled nightly".
#
# Pick one:
#
#   travelpayouts — https://travelpayouts.com → Developers → API tokens.
#                   Ordinary signup, token issued immediately, data is free
#                   (they make money when someone books through their links).
#                   Prices a whole month per call, which is exactly what we show.
#
#   amadeus       — https://developers.amadeus.com. Free test tier, but signup
#                   asks for company details and is often refused. Prices exact
#                   dates only, so we sample mid-month and hope it is typical.
#
# Leave FLIGHT_PRICING_PROVIDER blank to auto-pick whichever is configured
# (Travelpayouts first). Set it to "none" to force the guide.
FLIGHT_PRICING_PROVIDER=

TRAVELPAYOUTS_TOKEN=

AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# Set to "true" on exactly ONE deployment. That instance samples fares nightly
# and caches them in Redis; every other instance reads the cache. Visitor
# requests never call the provider regardless of this setting.
#
# To check a token without waiting for the nightly run:
#   GET /api/flights/diagnostics   (admin token required)
FLIGHT_PRICING_REFRESH_ENABLED=false

# ── Optional: Redis advanced (sentinel / cluster / fallback / health) ────────
# Leave unset for a single Redis instance. Defaults live in config/redis.js.
# REDIS_SENTINEL_ENABLED=false
# REDIS_SENTINEL_HOST=
# REDIS_SENTINEL_PORT=26379
# REDIS_SENTINEL_NAME=mymaster
# REDIS_SENTINEL_PASSWORD=
# REDIS_CLUSTER_ENABLED=false
# REDIS_CLUSTER_NODES=
# REDIS_FALLBACK_HOST=
# REDIS_FALLBACK_PORT=
# REDIS_FALLBACK_PASSWORD=
# REDIS_FALLBACK_DB=
# REDIS_FALLBACK_TTL=3600
# REDIS_FALLBACK_MAX_SIZE=1000
# REDIS_FALLBACK_CLEANUP_INTERVAL=300000
# REDIS_HEALTH_CHECK_INTERVAL=30000
# REDIS_HEALTH_CHECK_TIMEOUT=5000
# REDIS_MAX_FAILURES=3
# REDIS_RETRY_DELAY=1000
