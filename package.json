{
  "name": "ubuntu-footprints-backend",
  "version": "1.0.0",
  "description": "Backend for Ubuntu Footprints",
  "main": "server.js",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "cleanup": "node cleanup-tmp.js",
    "test:security": "node test-security-complete.js",
    "test:security:prod": "cross-env TEST_BASE_URL=https://api.ubuntufootprints.com node test-security-complete.js",
    "test:security:prod2": "cross-env TEST_BASE_URL=https://bntest.spiritrevivaltemple.org node test-security-complete.js",
    "check-prod": "node check-production.js"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^6.13.1",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^7.0.3",
    "rate-limit-redis": "^4.3.1",
    "sharp": "^0.35.2",
    "stripe": "^17.5.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^2.0.22"
  }
}
